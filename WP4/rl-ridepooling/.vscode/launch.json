{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "gym_test-rs",
            "type": "debugpy",
            "request": "launch",
            "program": "src/tests/gym_test-rs.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["-c", "configs/policy_training/old_net/default.yaml"]
        },
        {
            "name": "gym_test-rs (Full Parameters)",
            "type": "debugpy",
            "request": "launch",
            "program": "src/tests/gym_test-rs.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config", "configs/policy_training/base.yaml",
                "--num-envs", "1",
                "--basic-episodes", "32",
                "--seed", "42",
                "--sumo-seed", "42",
                "--delta", "1",
                "--train-freq", "1",
                "--gradient-steps", "1",
                "--scaling-coef", "0",
                "--sumocfg", "nets/ridepooling/Helsinki updated areas/area1/area1_sampled_1.0_3000.sumocfg.xml",
                "--postfix", "local_test"
            ]
        },
        {
            "name": "genPassengers.py",
            "type": "debugpy",
            "request": "launch",
            "program": "src/demand generation/genPassengers.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["-c", "configs/gen_passengers/area1/area1_sampled_0.2.yaml"]
        },
        {
            "name": "drawPerformanceGraphs",
            "type": "debugpy",
            "request": "launch",
            "program": "src/tests/graphs/draw_performance_graphs.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "performanceModelParser",
            "type": "debugpy",
            "request": "launch",
            "program": "src/utils/performance_model_output_parser.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        }
    ]
}